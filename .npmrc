# Keep every cache/store inside the repo.
#
# Why: the package manager's default store and cache live in the user profile
# (e.g. %LOCALAPPDATA%\npm-cache). In sandboxed/CI/container runs those paths may
# be read-only, which makes `install` fail with a confusing EPERM before a single
# package is fetched. Repo-local paths make installs hermetic and reproducible.
store-dir=.pnpm-store
cache-dir=.pnpm-cache

# Fail loudly if a dependency declares an engine we do not satisfy.
engine-strict=true

# Workspace packages (@notched/protocol) must resolve to the local source, never
# to a published package of the same name.
link-workspace-packages=true
