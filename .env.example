# mstamp backend configuration.
#
# Copy to `.env` — which is git-ignored — and fill in the values.
#
# The service refuses to start if a required variable is missing. That is
# deliberate in every mode, including local development: there is no fallback
# signing key, because a service that boots without one accepts work it cannot
# turn into a verifiable receipt, and the only symptom would be an empty
# database.
#
# Generate both keys with:
#   openssl rand -base64 32
#
# See `docs/deploy.md` for the order these are needed in.

# ---------------------------------------------------------------------------
# Two database URLs, and the difference is a security boundary.
# ---------------------------------------------------------------------------

# What the SERVICE connects as. Must be `mstamp_app`.
#
# Row-level security is bypassed by superusers and by table owners, so connecting
# as the owner would silently disable tenant isolation — the service would keep
# working, all its tests would pass, and the boundary would simply not exist.
DATABASE_URL=postgres://mstamp_app:change-me@localhost:5432/mstamp

# What MIGRATIONS connect as: the database owner.
#
# Migrations create tables, the `mstamp_app` role and the RLS policies, so they
# need more privilege than the service is allowed. Used only by `pnpm migrate`
# and `pnpm issue-key`, never by the running service.
MIGRATION_DATABASE_URL=postgres://owner:change-me@localhost:5432/mstamp

# Password for `mstamp_app`, applied by `pnpm migrate` on every release.
#
# Migration 002 creates the role with `CREATE ROLE`, which is NOLOGIN, and
# migration 005 grants LOGIN. This variable supplies the password half. If it is
# unset, migrate leaves the existing password alone rather than blanking it.
MSTAMP_APP_PASSWORD=

# ---------------------------------------------------------------------------
# Keys
# ---------------------------------------------------------------------------

# Ed25519 signing key: base64 of the raw 32-byte seed. Signs every receipt.
#
# Back this up. Losing it means you can never sign again under this key id;
# leaking it means someone can forge receipts that verify against your published
# public key. There is no recovery for either.
#
# The published test fixtures are rejected at startup: 32 bytes of a single repeated
# value is a key anyone who has read the repository can sign with.
MSTAMP_SIGNING_KEY=

# Which signing key produced a receipt. **Required, with no default.**
#
# A receipt names its signing key only by this id - it carries no issuer field - so
# two deployments that share one are indistinguishable to a verifier. Pick something
# unique to this deployment, e.g. `acme-2026-01`. Rotating the key issues a new id,
# and `GET /v1/keys` publishes every key ever used, so historic receipts stay
# verifiable. Never delete an old key.
MSTAMP_SIGNING_KEY_ID=

# Payload encryption key: base64 of 32 bytes. Per-tenant AES-256-GCM keys for
# stored response-body previews are derived from this via HKDF-SHA256.
MSTAMP_MASTER_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# HTTP port. Defaults to 3000.
PORT=3000

# Interface to bind. Defaults to 0.0.0.0, which is what a container needs;
# binding to 127.0.0.1 produces a deploy that starts cleanly and never answers.
HOST=0.0.0.0

# `development` or `production`.
NODE_ENV=development
