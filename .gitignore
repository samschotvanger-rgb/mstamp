# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Compiled output must never land beside its sources. tsc emits to dist/ (see each
# package's tsconfig.build.json), but a misconfigured rootDir/outDir drops .js and
# .d.ts next to the .ts files instead. That happened once, through a `paths`
# mapping that pulled one package's source into another package's program.
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map

# Test output
coverage/

# Scratch space for tests (temporary SQLite files and their WAL sidecars)
.tmp/

# Repo-local package manager state (see .npmrc)
.pnpm-store/
.pnpm-cache/
.npm-cache/

# Scratch space used while vendoring reference test data
.vendor-tmp/

# Secrets - never commit a signing key or API key
.env
.env.*
!.env.example
*.pem
*.key

# SDK local receipt store (DEFAULT_LOCAL_DB_PATH in protocol/src/telemetry.ts)
.mstamp/

# OS / editor
.DS_Store
Thumbs.db
*.log
