{
  "name": "@mstamp/protocol",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "mstamp protocol: receipt types, RFC 8785 canonicalization, SHA-256 hashing, redaction, response validation, the fetch-interception client, and the fail-open telemetry queue.",
  "homepage": "https://github.com/samschotvanger-rgb/mstamp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samschotvanger-rgb/mstamp.git",
    "directory": "packages/protocol"
  },
  "bugs": {
    "url": "https://github.com/samschotvanger-rgb/mstamp/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "canonicalize": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "json-canonicalize": "^3.0.1",
    "json-freeze": "1.0.0",
    "zod": "4.6.6"
  }
}
