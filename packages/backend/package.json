{
  "name": "@mstamp/backend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "mstamp backend: Hono app, Postgres storage with row-level tenant isolation, and Ed25519 receipt signing.",
  "homepage": "https://github.com/samschotvanger-rgb/mstamp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samschotvanger-rgb/mstamp.git",
    "directory": "packages/backend"
  },
  "bugs": {
    "url": "https://github.com/samschotvanger-rgb/mstamp/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/serve.js",
    "migrate": "node dist/bin/migrate.js",
    "issue-key": "node dist/bin/issue-key.js",
    "purge": "node dist/bin/purge.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@mstamp/protocol": "workspace:*",
    "@noble/ed25519": "3.2.0",
    "hono": "^4.13.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "5.9.3",
    "vitest": "~4.1.11"
  }
}
